#!/bin/bash
# minbar — MinBar's command line (cli/). `make install` bakes the two paths
# below; run from a checkout they resolve next to this file, helpers in build/bin.
set -euo pipefail
MINBAR_ROOT="@MINBAR_ROOT@"
MINBAR_LIBEXEC="@MINBAR_LIBEXEC@"
case "$MINBAR_ROOT" in
  @*)
    _self="$0"
    [ -L "$_self" ] && _self="$(realpath "$_self")"
    MINBAR_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
    MINBAR_LIBEXEC="$MINBAR_ROOT/build/bin"
    unset _self
    ;;
esac
export MINBAR_ROOT MINBAR_LIBEXEC
# The macOS tools (defaults, codesign, security, launchctl, shasum) come last, so
# a restricted PATH such as home-manager's activation still finds them.
export PATH="$MINBAR_LIBEXEC:$PATH:/usr/bin:/bin:/usr/sbin:/sbin"
# shellcheck source=../cli/main.sh
source "$MINBAR_ROOT/cli/main.sh"
